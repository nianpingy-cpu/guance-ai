{
  "name": "guancha-ai-web-mvp",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "screenshots": "node scripts/screenshots.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "lint": "eslint .",
    "ui:verify": "node scripts/ui-verify.mjs",
    "ui:visual": "node scripts/visual-verify.mjs",
    "typecheck:desktop": "tsc -p tsconfig.desktop.json",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:test": "node scripts/desktop-verify.mjs",
    "desktop:pack": "npm run desktop:build && electron-builder --publish never"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^25.0.1",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=24.13.0"
  },
  "description": "观策AI本地营销决策桌面试用版",
  "author": "Nianping",
  "main": "desktop-dist/main.cjs",
  "build": {
    "appId": "com.guanceai.desktop",
    "productName": "观策AI",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop-dist/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "THIRD_PARTY_LICENSES.txt"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.business",
      "icon": "public/icon.png",
      "identity": null
    },
    "artifactName": "GuanceAI-${os}-${arch}-${version}.${ext}"
  }
}
